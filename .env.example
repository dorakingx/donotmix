# Copy to .env and fill in. Never commit .env.
# Flagsmith instance. Self-hosted (deploy/flagsmith) defaults to http://localhost:8000.
FLAGSMITH_API_URL=http://localhost:8000
# Admin (Master) API key, host-scoped as required by the Flagsmith CLI v2:
#   https://api.flagsmith.com      -> FLAGSMITH_API_KEY
#   http://localhost:8000          -> FLAGSMITH_API_KEY_localhost_8000
FLAGSMITH_API_KEY_localhost_8000=
# Optional: MixMart storefront remote evaluation (client-side environment key)
FLAGSMITH_ENVIRONMENT_KEY=
# Optional: LLM analysis (opt-in, budget-capped). Not needed for the deterministic engine.
ANTHROPIC_API_KEY=
